{
  "name": "univille-eventos",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,blue \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w @univille/api",
    "dev:web": "npm run dev -w @univille/web",
    "build": "npm run build -w @univille/web",
    "start": "npm run start -w @univille/api",
    "test": "npm run test -w @univille/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "db:up": "docker compose -f docker-compose.dev.yml up -d --wait",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:migrate": "npm run db:migrate -w @univille/api",
    "db:seed": "npm run db:seed -w @univille/api",
    "db:reset": "npm run db:reset -w @univille/api",
    "postinstall": "node scripts/preparar-env.mjs && npm run db:generate -w @univille/api",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier --write .",
    "prettier:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.72.0"
  },
  "engines": {
    "node": ">=22"
  }
}
