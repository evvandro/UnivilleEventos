{
  "name": "univille-eventos",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @univille/api & npm run dev -w @univille/web & wait",
    "dev:api": "npm run dev -w @univille/api",
    "dev:web": "npm run dev -w @univille/web",
    "build": "npm run build -w @univille/web",
    "start": "npm run start -w @univille/api",
    "test": "npm run test -w @univille/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run typecheck",
    "format": "prettier --write .",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:migrate": "npm run db:migrate -w @univille/api",
    "db:seed": "npm run db:seed -w @univille/api",
    "db:reset": "npm run db:reset -w @univille/api",
    "postinstall": "npm run db:generate -w @univille/api"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  }
}
